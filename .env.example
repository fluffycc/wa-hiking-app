# ── Azure Cosmos DB (free tier) ───────────────────────────────────────────────
# Create at: portal.azure.com → Cosmos DB → Create → Serverless
COSMOS_ENDPOINT=https://YOUR_ACCOUNT.documents.azure.com:443/
COSMOS_KEY=YOUR_PRIMARY_KEY
COSMOS_DB_NAME=wa-hiking
COSMOS_CONTAINER=trails

# ── Sync security ─────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
SYNC_SECRET_TOKEN=your_random_secret_here

# ── WSDOT Mountain Pass API (free key) ───────────────────────────────────────
# Register at: wsdot.wa.gov/traffic/api
WSDOT_ACCESS_CODE=your_wsdot_key_here

# ── GitHub feedback issues ────────────────────────────────────────────────────
GITHUB_TOKEN=your_github_pat
GITHUB_OWNER=your_github_username
GITHUB_REPO=wa-hiking-app
GITHUB_LABELS=feedback,from-app
