{
  "routes": [
    {
      "route": "/api/*",
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/*",
      "serve": "/index.html",
      "statusCode": 200
    }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/api/*", "*.{css,scss,js,ts,jsx,tsx,png,gif,ico,txt,json,svg,woff,woff2}"]
  },
  "platform": {
    "apiRuntime": "node:20"
  }
}
